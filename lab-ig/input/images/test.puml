@startuml
title StudyFinder-profiler og relasjoner
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false

class StudyFinderResearchStudy <<ResearchStudy>> {
    +title : string
    +status : code
    +sponsor : Reference(StudyFinderOrganization)
    +site : Reference(StudyFinderLocation)
    +enrollment : Reference(StudyFinderStudyPopulation)
}

class StudyFinderStudyPopulation <<Group>> {
    +type : code
    +actual : boolean = false
    +characteristic : criteria
}

class StudyFinderOrganization <<Organization>> {
    +name : string
}

class StudyFinderLocation <<Location>> {
    +address : Address
    +position : coordinates
    +managingOrganization : Reference(StudyFinderOrganization)
}

class StudyFinderParticipant <<Patient>> {
    +birthDate : date
    +gender : code
    +address : Address
}

class StudyFinderCondition <<Condition>> {
    +code : CodeableConcept
    +clinicalStatus : CodeableConcept
}

class StudyFinderHealthStatus <<Observation>> {
    +code : CodeableConcept = health-status
    +valueCodeableConcept : no-known-indications | known-indications | not-assessed
    +subject : Reference(StudyFinderParticipant)
}

class StudyFinderObservation <<Observation>> {
    +code : CodeableConcept
    +value[x] : value
}

class StudyFinderMedicationStatement <<MedicationStatement>> {
    +medication[x] : CodeableConcept or Reference
}

class StudyFinderQuestionnaire <<Questionnaire>> {
    +status : code
    +item : items
}

class StudyFinderQuestionnaireResponse <<QuestionnaireResponse>> {
    +questionnaire : canonical
    +status : code
    +item : answers
}

StudyFinderResearchStudy --> StudyFinderOrganization : sponsor
StudyFinderResearchStudy --> StudyFinderLocation : site
StudyFinderResearchStudy --> StudyFinderStudyPopulation : enrollment
StudyFinderLocation --> StudyFinderOrganization : managingOrganization
StudyFinderQuestionnaireResponse --> StudyFinderQuestionnaire : questionnaire
StudyFinderQuestionnaireResponse --> StudyFinderParticipant : subject
StudyFinderCondition --> StudyFinderParticipant : subject
StudyFinderHealthStatus --> StudyFinderParticipant : subject
StudyFinderObservation --> StudyFinderParticipant : subject
StudyFinderMedicationStatement --> StudyFinderParticipant : subject

note bottom of StudyFinderStudyPopulation
    Inclusion and exclusion criteria
    are expressed as characteristics.
end note

note bottom of StudyFinderParticipant
    Use only the data needed
    for preliminary matching.
end note
@enduml
